{
  "name": "ring-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:3010": "next dev --port 3010",
    "dev:3001": "next dev --port 3001",
    "dev:node": "node ./node_modules/next/dist/bin/next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "dev:lan:node": "node ./node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:gaze": "eslint \"lib/gaze/**/*.ts\" \"hooks/useEyedidGaze.ts\" \"components/kiyoko/EyedidCalibrationOverlay.tsx\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install",
    "run:quality": "node ./tools/run-quality.mjs",
    "run:verify": "node ./tools/run-verify.mjs",
    "run:auto": "node ./tools/auto-run.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@sentry/nextjs": "^10.52.0",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@upstash/redis": "^1.38.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.9.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "seeso": "^0.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.0.2",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
