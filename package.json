{
  "name": "ring-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:3010": "next dev --port 3010",
    "dev:3001": "next dev --port 3001",
    "dev:node": "node ./node_modules/next/dist/bin/next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "dev:lan:node": "node ./node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:gaze": "eslint \"lib/gaze/**/*.ts\" \"hooks/useEyedidGaze.ts\" \"components/kiyoko/EyedidCalibrationOverlay.tsx\"",
    "test": "vitest",
    "test:run": "vitest run",
    "run:quality": "node ./tools/run-quality.mjs",
    "run:verify": "node ./tools/run-verify.mjs",
    "run:auto": "node ./tools/auto-run.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "seeso": "^0.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
