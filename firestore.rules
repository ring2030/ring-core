rules_version = '2';

// Firestore security rules for ring-core (MERGE-READY snippet).
//
// IMPORTANT:
//   This file currently only declares the *audit log* policy. Your existing
//   collections (calls, messages, video, demo data, etc.) are governed by
//   whatever rules are already deployed in your Firebase project. When you
//   roll this file out, MERGE these blocks into the rules file you actually
//   deploy — do not blindly replace your live rules with this snippet, or
//   client-side reads of calls/messages will start failing.
//
// Audit log policy:
//   - `audit_logs` is server-only (Firebase Admin SDK).
//   - Any client tier (web SDK, mobile SDK, anonymous) must NOT read or write
//     directly. The Next.js API routes /api/audit-logs and
//     /api/audit-logs/export are the only sanctioned read paths, and writes
//     happen through the Admin SDK in `lib/audit/auditLog.ts`.
//   - This is a defence-in-depth guard against compromised client credentials
//     and protects the integrity of the audit trail.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Audit log (server-only) -----------------------------------------
    match /audit_logs/{docId} {
      allow read, write: if false;
    }

    // --- Public Health Insight Layer (PHIL) aggregates -------------------
    //   * Read: public (no auth). These documents are explicitly designed
    //     to be researcher- and journalist-readable; they contain only
    //     anonymized counts / proportions, with k-anonymity suppression
    //     applied by the writer (see `lib/stats/quality.ts`).
    //   * Write: server-only (firebase-admin from the cron job at
    //     /api/cron/aggregate-phil). Client SDKs MUST NOT be able to
    //     fabricate or alter PHIL documents.
    match /phil_aggregates/{date} {
      allow read: if true;
      allow write: if false;
    }

    // If AUDIT_LOGS_COLLECTION is overridden to a hospital-scoped name,
    // mirror the deny-rule here as well, e.g.:
    //
    //   match /audit_logs_{hospitalId}/{docId} {
    //     allow read, write: if false;
    //   }
  }
}
