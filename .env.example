# コピーして .env.local を作成し、値を埋める。
# 本番（Vercel 等）ではダッシュボードの Environment Variables に同じキーを設定する。

# --- Gemini（サーバー API ルートのみ）---
GEMINI_API_KEY=
# 省略時は Google 公式 v1beta
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FAMILY_MODEL=gemini-1.5-flash
# 任意: AIエンドポイントのレート制限（IP単位、固定ウィンドウ）
# RATE_LIMIT_CHAT_MAX_REQUESTS=12
# RATE_LIMIT_CHAT_WINDOW_MS=60000
# RATE_LIMIT_CHAT_QUIET_HOURS_JST_START=0
# RATE_LIMIT_CHAT_QUIET_HOURS_JST_END=6
# RATE_LIMIT_CHAT_QUIET_HOURS_MULTIPLIER=1.5
# 任意: nurseセッション用の別枠（通常枠と独立カウント）
# RATE_LIMIT_CHAT_NURSE_MAX_REQUESTS=20
# RATE_LIMIT_CHAT_NURSE_WINDOW_MS=60000
# RATE_LIMIT_CHAT_NURSE_QUIET_HOURS_JST_START=0
# RATE_LIMIT_CHAT_NURSE_QUIET_HOURS_JST_END=6
# RATE_LIMIT_CHAT_NURSE_QUIET_HOURS_MULTIPLIER=1.5
# RATE_LIMIT_FAMILY_SUMMARY_MAX_REQUESTS=6
# RATE_LIMIT_FAMILY_SUMMARY_WINDOW_MS=60000
# RATE_LIMIT_FAMILY_SUMMARY_QUIET_HOURS_JST_START=0
# RATE_LIMIT_FAMILY_SUMMARY_QUIET_HOURS_JST_END=6
# RATE_LIMIT_FAMILY_SUMMARY_QUIET_HOURS_MULTIPLIER=1.5
# RATE_LIMIT_FAMILY_SUMMARY_NURSE_MAX_REQUESTS=10
# RATE_LIMIT_FAMILY_SUMMARY_NURSE_WINDOW_MS=60000
# RATE_LIMIT_FAMILY_SUMMARY_NURSE_QUIET_HOURS_JST_START=0
# RATE_LIMIT_FAMILY_SUMMARY_NURSE_QUIET_HOURS_JST_END=6
# RATE_LIMIT_FAMILY_SUMMARY_NURSE_QUIET_HOURS_MULTIPLIER=1.5
# 分散カウント（推奨）: Vercel KV / Upstash Redis REST
# 本番 (NODE_ENV=production) では必須。未設定時は API が 503 で fail-close します。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# （または）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- 役割ログイン/招待URL（サーバー署名）---
# 本番では必須。未設定で NODE_ENV=production だと token 発行/検証が落ちる。
# 32バイト以上の暗号学的乱数を推奨（例: openssl rand -base64 48）
APP_SIGNING_SECRET=

# --- Firebase クライアント（NEXT_PUBLIC_ はブラウザに埋め込まれる）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin（監査ログをFirestoreに永続化するサーバー用。どちらか一方）---
# 本番では必須。未設定だと audit log の書き込み/読み取り API が起動時 or 初回呼び出しで明示的に失敗する。
# JSONが壊れている場合は黙って fallback せず、明確なエラーで起動を止める。
# 方式A: 1行JSON（推奨）
# FIREBASE_SERVICE_ACCOUNT_JSON={"projectId":"...","clientEmail":"...","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# 方式B: 分割キー
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 任意: 監査ログコレクション名（既定 audit_logs）
# AUDIT_LOGS_COLLECTION=audit_logs
# 必要: Firestore 複合インデックス (hospitalId ASC, at DESC) を firestore.indexes.json から deploy

# 任意: ビデオレター等のコレクション名
# NEXT_PUBLIC_VIDEO_MESSAGES_COLLECTION=messages
# 任意: 看護ダッシュボード分析を実データ集計に切替 (1=ON, 未設定=モック維持)
# NEXT_PUBLIC_NURSE_ANALYTICS_LIVE=1
# 任意: 会話モーダルの家族写真URL（設定時はアニメ背景で表示）
# NEXT_PUBLIC_FAMILY_PHOTO_URL=https://example.com/family.jpg

# --- Eyedid / seeso（視線。本番 URL は Eyedid コンソール側でドメイン許可が必要な場合あり）---
NEXT_PUBLIC_EYEDID_LICENSE_KEY=

# --- ローカル開発のみ（本番では通常不要）---
# 3000 が競合する場合は npm run dev:3010 または .\dev.ps1 -Port 3010
